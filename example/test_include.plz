INCLUDE "libplz.plz"

// A simple checkerboard tile pattern (2 tiles, 32 bytes each)
tiles: DATA
  0xFF, 0x81, 0x81, 0xFF, 0x81, 0x81, 0xFF, 0x81,
  0x81, 0xFF, 0x81, 0x81, 0xFF, 0x81, 0x81, 0xFF,
  0xFF, 0x81, 0x81, 0xFF, 0x81, 0x81, 0xFF, 0x81,
  0x81, 0xFF, 0x81, 0x81, 0xFF, 0x81, 0x81, 0xFF,
  0x81, 0xFF, 0x81, 0x81, 0xFF, 0x81, 0x81, 0xFF,
  0x81, 0x81, 0xFF, 0x81, 0x81, 0xFF, 0x81, 0x81,
  0x81, 0xFF, 0x81, 0x81, 0xFF, 0x81, 0x81, 0xFF,
  0x81, 0x81, 0xFF, 0x81, 0x81, 0xFF, 0x81, 0x81

start:
  CALL screen_mode_4()
  CALL load_palette_default()
  CALL load_tiles(128, tiles, 2)
  CALL set_cursor(10, 10)
  CALL print_char('A')
  HALT
