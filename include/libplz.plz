// libplz.plz — PLZ Standard Library for Sega Master System
// Provides console hardware access through PLZ procedures.

// ============================================================
// VDP (Video Display Processor) routines
// Ports: 0xBE = data, 0xBF = control/status
// ============================================================

// Write a VDP register.
PROCEDURE write_vdp_reg(reg BYTE, value BYTE)
  OUTPUT WORD 0xBF value | ((reg | 0x80) << 8)
END

// Set VRAM write address (for subsequent writes to port 0xBE).
PROCEDURE set_write_addr(addr WORD)
  OUTPUT WORD 0xBF (addr | 0x4000)
END

// Set VRAM read address (for subsequent reads from port 0xBE).
PROCEDURE set_read_addr(addr WORD)
  OUTPUT WORD 0xBF (addr & 0x3FFF)
END

// Set CRAM (palette) write address for subsequent writes to port 0xBE.
// addr is a 5-bit CRAM byte address (0-31).
PROCEDURE set_cram_addr(addr BYTE)
  OUTPUT WORD 0xBF (addr & 0x1F) | 0xC000
END

// Write a byte to VRAM at the given address.
PROCEDURE write_vram(addr WORD, value BYTE)
  CALL set_write_addr(addr)
  OUTPUT 0xBE value
END

// Read a byte from VRAM at the given address.
// VDP has a read-ahead buffer; the first read returns stale data,
// so we do a dummy read first then return the actual value.
PROCEDURE read_vram(addr WORD) BYTE
  DECLARE dummy BYTE
  CALL set_read_addr(addr)
  LET dummy = INPUT(0xBE)
  RETURN INPUT(0xBE)
END

// Clear the screen (fill tile map at 0x3800 with space character).
PROCEDURE cls()
  DECLARE ii WORD
  CALL set_write_addr(0x3800)
  FOR ii = 0 TO 0x5FF DO
    OUTPUT 0xBE 0x20
  END
END

// Fill a region of VRAM with a byte value.
PROCEDURE fill_vram(addr WORD, value BYTE, count WORD)
  DECLARE idx WORD
  CALL set_write_addr(addr)
  FOR idx = 0 TO count - 1 DO
    OUTPUT 0xBE value
  END
END

// Copy count bytes from RAM to VRAM.
// Used as the building block for tile/sprite/palette loading.
PROCEDURE copy_vram(dest WORD, source DATA, count WORD)
  DECLARE ii WORD
  CALL set_write_addr(dest)
  FOR ii = 0 TO count - 1 DO
    OUTPUT 0xBE source[ii]
  END
END

// Load count tiles (each 32 bytes) into the pattern table starting at tile index idx.
// Pattern table base is 0x0000 in SMS mode 4; each 8x8 tile occupies 32 bytes (4 bpp).
// Example: CALL load_tiles(128, my_tiles, 16)
PROCEDURE load_tiles(idx BYTE, tiles DATA, count BYTE)
  CALL copy_vram(idx << 5, tiles, count << 5)
END

// Load count sprite patterns into the sprite pattern table starting at sprite index idx.
// Sprite pattern base is at 0x2000 in SMS mode 4.
// Each sprite occupies 32 bytes; see load_tiles for details.
PROCEDURE load_sprites(idx BYTE, sprites DATA, count BYTE)
  CALL copy_vram(0x2000 + (idx << 5), sprites, count << 5)
END

// Load count palette entries from DATA to the SMS palette (CRAM).
// Each palette entry is 1 byte in SMS format (00BBGGRR).
// count must be <= 32 (32 bytes for tile + sprite palettes).
PROCEDURE load_palette(pal DATA, count BYTE)
  DECLARE ii BYTE
  CALL set_cram_addr(0)
  FOR ii = 0 TO count - 1 DO
    OUTPUT 0xBE pal[ii]
  END
END

// ============================================================
// Screen control
// ============================================================

PROCEDURE disable_screen()
  CALL write_vdp_reg(1, 0x80)
END

PROCEDURE enable_screen()
  CALL write_vdp_reg(1, 0xE0)
END

// ============================================================
// Screen mode initialization (SMS Mode 4)
// Sets up VDP for 32x24 tile mode with sprite support.
// Name table at 0x3800, sprite table at 0x3F00, pattern at 0x0000.
// ============================================================

PROCEDURE screen_mode_4()
  CALL disable_screen()
  CALL write_vdp_reg(0, 0x04)   // Reg 0: Mode 4
  CALL write_vdp_reg(1, 0x82)   // Reg 1: Display off, VBlank IRQ, 16K
  CALL write_vdp_reg(2, 0x0E)   // Reg 2: Name table at 0x3800
  CALL write_vdp_reg(3, 0xFF)   // Reg 3: Reserved (set $FF)
  CALL write_vdp_reg(4, 0x07)   // Reg 4: Reserved (set $07)
  CALL write_vdp_reg(5, 0x7E)   // Reg 5: Sprite table at 0x3F00
  CALL write_vdp_reg(6, 0x00)   // Reg 6: Sprite pattern base at 0x0000
  CALL write_vdp_reg(7, 0x00)   // Reg 7: Border color
  CALL write_vdp_reg(8, 0x00)   // Reg 8: Background X scroll
  CALL write_vdp_reg(9, 0x00)   // Reg 9: Background Y scroll
  CALL fill_vram(0x3F00, 0xE0, 256) // Hide all sprites off-screen
  CALL cls()
  CALL enable_screen()
END


// border_color sets the border color
PROCEDURE border_color(color BYTE)
  CALL write_vdp_reg(7, color)
END

// ============================================================
// Palette
// SMS palette is 32 bytes of CRAM: 00BBGGRR (2-bit per channel RGB).
// Entries 0-15 = tile palette, entries 16-31 = sprite palette.
// ============================================================

// Load a single SMS palette entry.
// entry is the 0-based palette index (0-31).
// color is a BYTE in SMS format (00BBGGRR).
PROCEDURE load_palette_entry(entry BYTE, color BYTE)
  CALL set_cram_addr(entry)
  OUTPUT 0xBE color
END

// Load the default 16-color SMS palette.
PROCEDURE load_palette_default()
  CALL load_palette_entry(0,  0x00)  // Transparent
  CALL load_palette_entry(1,  0x00)  // Black
  CALL load_palette_entry(2,  0x0C)  // Green
  CALL load_palette_entry(3,  0x1C)  // Light green
  CALL load_palette_entry(4,  0x30)  // Blue
  CALL load_palette_entry(5,  0x34)  // Light blue
  CALL load_palette_entry(6,  0x02)  // Dark red
  CALL load_palette_entry(7,  0x3C)  // Cyan
  CALL load_palette_entry(8,  0x03)  // Red
  CALL load_palette_entry(9,  0x0B)  // Light red
  CALL load_palette_entry(10, 0x0F)  // Yellow
  CALL load_palette_entry(11, 0x2C)  // Pastel green
  CALL load_palette_entry(12, 0x20)  // Dark blue
  CALL load_palette_entry(13, 0x33)  // Pink
  CALL load_palette_entry(14, 0x2F)  // Light yellow
  CALL load_palette_entry(15, 0x3F)  // White
END

// ============================================================
// Controller input (SMS ports)
// Port 0x3F: controller select
// Port 0xDC: joypad port 1, Port 0xDD: joypad port 2
// ============================================================

// Read joypad 1 state. Returns bitmask of pressed buttons.
// Bits: 0=Up, 1=Down, 2=Left, 3=Right, 4=B1, 5=B2
PROCEDURE read_joy1() BYTE
  OUTPUT 0x3F 0x40
  RETURN INPUT(0xDC) ^ 0xFF
END

PROCEDURE read_joy2() BYTE
  OUTPUT 0x3F 0x40
  RETURN INPUT(0xDD) ^ 0xFF
END

// ============================================================
// Timing / Frame sync
// ============================================================

// Wait for vertical blanking interval (start of next frame) by polling.
// This procedure should be called before writing to the screen
// to avoid screen flashing.
PROCEDURE wait_vsync()
  WHILE (INPUT(0xBF) & 0x80) == 0 DO
  END
END


DECLARE vsync_flag BYTE
DECLARE vsync_status BYTE

// Install this interrupt handler to be able to use halt_vsync.
//
INTERRUPT PROCEDURE int_vsync()
    // Acknowledge the VDP interrupt by reading port $BF
	LET vsync_status = INPUT(0xBF)
	LET vsync_flag = vsync_flag + 1
	ENABLE
END

// Wait for vertical blanking interval (start of next frame) by interrupt.
// You must install int_vsync as the interrupt handler.
// This procedure should be called before writing to the screen
// to avoid screen flashing.
PROCEDURE halt_vsync()
	ENABLE
	HALT
END




// ============================================================
// Text output
// Cursor stores VRAM address for the next character.
// Tile map base = 0x3800, 32 cols x 24 rows, 2 bytes per tile.
// ============================================================

DECLARE cursor WORD

// Print a single character at cursor, advance cursor.
PROCEDURE print_char(ch BYTE)
  CALL write_vram(cursor, ch)
  LET cursor = cursor + 2
END

// Set cursor to screen column/row (0-indexed).
PROCEDURE set_cursor(col BYTE, row BYTE)
  LET cursor = 0x3800 + (row * 32 + col) * 2
END
