// music_test.plz — PL/Z music demo
// Uses SMS PSG (SN76489) on I/O port 0x7F.
//
// Demonstrates the music library from include/music.plz:
//   - Song data format with 5-byte entries
//   - play_song (play once) and play_song_loop (loop)
//   - Sustain (freq=0xFFFF), rest (freq=0)
//   - Multi-octave range (C4-C6)
//   - Noise channel
//
// Timing: requires TASK context with SLEEP + VBlank interrupt or timer task.
// See the comment block at the end for setup instructions.

INCLUDE "music.plz"

// ---------------------------------------------------------------
// "Mary Had a Little Lamb" — demonstrates basic note format
// Each entry: freq_L, freq_H, duration, channel, volume
// The PLZ compiler evaluates C4 , C4 >> 8 at compile time.
// ---------------------------------------------------------------
DATA mary
  E4 , E4 >> 8, 1, 0, 10,
  D4 , D4 >> 8, 1, 0, 10,
  C4 , C4 >> 8, 1, 0, 10,
  D4 , D4 >> 8, 1, 0, 10,
  E4 , E4 >> 8, 1, 0, 10,
  E4 , E4 >> 8, 1, 0, 10,
  E4 , E4 >> 8, 2, 0, 10,
  D4 , D4 >> 8, 1, 0, 10,
  D4 , D4 >> 8, 1, 0, 10,
  D4 , D4 >> 8, 2, 0, 10,
  E4 , E4 >> 8, 1, 0, 10,
  G4 , G4 >> 8, 1, 0, 10,
  G4 , G4 >> 8, 2, 0, 10,
  E4 , E4 >> 8, 1, 0, 10,
  D4 , D4 >> 8, 1, 0, 10,
  C4 , C4 >> 8, 1, 0, 10,
  D4 , D4 >> 8, 1, 0, 10,
  E4 , E4 >> 8, 1, 0, 10,
  E4 , E4 >> 8, 1, 0, 10,
  E4 , E4 >> 8, 1, 0, 10,
  E4 , E4 >> 8, 1, 0, 10,
  D4 , D4 >> 8, 1, 0, 10,
  D4 , D4 >> 8, 1, 0, 10,
  E4 , E4 >> 8, 1, 0, 10,
  D4 , D4 >> 8, 1, 0, 10,
  C4 , C4 >> 8, 3, 0, 10,
  0, 0, 0, 0, 0xFF                  // end marker

// ---------------------------------------------------------------
// Sustain demo: hold a note while playing melody on another channel
// Ch0: bass note held via sustain (0xFFFF)
// Ch1: melody
// ---------------------------------------------------------------
DATA sustain_demo
  // Bar 1: hold C3 bass, play C4-E4 melody
  C3 , C3 >> 8, 4, 0, 6,     // C3 bass on ch0
  C4 , C4 >> 8, 4, 1, 10,    // C4 melody on ch1
  0xFF, 0xFF, 4, 0, 0,             // sustain C3 on ch0
  E4 , E4 >> 8, 4, 1, 10,   // E4 melody on ch1
  0xFF, 0xFF, 4, 0, 0,             // sustain C3
  G4 , G4 >> 8, 4, 1, 10,   // G4 melody
  // Bar 2: rest + new bass
  0, 0, 2, 0, 15,                  // rest on ch0 (silent)
  A3 , A3 >> 8, 4, 0, 6,     // A3 bass
  A4 , A4 >> 8, 4, 1, 10,   // A4 melody
  0xFF, 0xFF, 4, 0, 0,             // sustain A3
  G4 , G4 >> 8, 4, 1, 10,   // G4 melody
  0xFF, 0xFF, 4, 0, 0,             // sustain A3
  F4 , F4 >> 8, 4, 1, 10,   // F4 melody
  0, 0, 0, 0, 0xFF                  // end

// ---------------------------------------------------------------
// Noise demo: drum/percussion effects on noise channel (ch 3)
// Noise format: freq=noise_rate (0-3), channel=3
// ---------------------------------------------------------------
DATA noise_demo
  C4 , C4 >> 8, 2, 0, 10,   // tone
  E4 , E4 >> 8, 2, 1, 10,
  0, 0, 1, 3, 6,                    // noise burst (rate=0, vol=6)
  G4 , G4 >> 8, 2, 0, 10,
  C5 , C5 >> 8, 2, 1, 10,
  0, 0, 1, 3, 6,                    // noise burst
  0, 0, 0, 0, 0xFF

// ---------------------------------------------------------------
// Playback tasks
// ---------------------------------------------------------------

// Play "Mary Had a Little Lamb" once
TASK mary_task PRIORITY 4
  CALL psg_silence()
  CALL play_song(mary)
  WHILE 1 DO YIELD END
END

// Play a looping sustain demo
TASK sustain_task PRIORITY 4
  CALL psg_silence()
  CALL play_song_loop(sustain_demo, 0)
  WHILE 1 DO YIELD END
END

// Play noise demo once
TASK noise_task PRIORITY 4
  CALL psg_silence()
  CALL play_song(noise_demo)
  WHILE 1 DO YIELD END
END

// ---------------------------------------------------------------
// Setup instructions (uncomment in your main program):
//
//   INTERRUPT PROCEDURE tick()
//     CALL _plz_scheduler
//   END
//
//   ENABLE
//   OUTPUT 0xBF 0xE0   // VDP reg 1: display + VBlank int enable
//   OUTPUT 0xBF 0x81   // select reg 1
//
// Then SLEEP 60 ≈ 1 second (60 Hz NTSC VBlank).
// ---------------------------------------------------------------

// (psg_vol, delay, and old play_song are now in INCLUDE "music.plz")
