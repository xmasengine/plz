
GOTO start

palette: DATA 0x19
CONSTANT HI 'H'
CONSTANT HE 'E'

DECLARE player_x BYTE
DECLARE player_y BYTE
DECLARE player_sprite WORD

// Hello world for z80 and PL/Z
hello:
	OUTPUT 7 'H'
	OUTPUT 7 'E'
	OUTPUT 7 'L'
	OUTPUT 7 'L'
	OUTPUT 7 'O'
	OUTPUT 7 '\n'
	ENABLE
RETURN
	OUTPUT 7 'B'
	OUTPUT 7 'A'
	OUTPUT 7 'D'
HALT

start:
	DISABLE
	LET player_x = 10
	LET player_y = 20
	CALL hello
	HALT

