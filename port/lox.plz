		IF map_flag_peek AND FLAG_HARM THEN PRINT_XY(17, 23, "H")
		IF map_flag_peek AND FLAG_BLESS THEN PRINT_XY(18, 23, "B")
		WAIT
	WEND
	SCREEN DISABLE
	WAIT
' halt
