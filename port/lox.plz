// Lord Of Xmas

INCLUDE "libplz.plz"

INTERRUPT int_vsync // install the interrupt handler.


TEMPLATE PRINT_XY `
	set_cursor($1, $2)
	print_char($3)
`


// Tile/Char memory layout:
// Tile 0 -> 32: HUD tiles.
// For now, loads  default font in the tiles from 32 to 127
// I will likely use a few less useful characters as icons or for translations.
// Tile 128 -> 191: Map tiles.
// Tile 192 -> 255: TBD.
CONSTANT TILE_FONT_MIN = 32
CONSTANT TILE_FONT_MAX = 127
CONSTANT TILE_MAP_MIN  = 128
CONSTANT TILE_MAP_LEN  = 64
CONSTANT TILE_MAP_MAX  = 128 + TILE_MAP_LEN

// 8 frames per player, foe, or character, 2 per direction for animation.
// Sprite layout on normal screen: 128 sprites available.
// 0 -   7: Player 1.
//  8 -  15: Player 1 special action.
// 16 -  19: Player 1 weapon.
// 20 -  23: Player 1 projectile.
// 24 -  31: Player 2.
// 32 -  39: Player 2 special action.
// 40 -  43: Player 2 weapon.
// 44 -  47: Player 2 projectile.
// 48 -  64: HUD Icons (16).
// 64 - 128: Presences loaded by the map. Includes foe weapons and projectiles.
//
// Sprite layout on menu screen is different and only has icons.
// Icon 0 is the cursor.
//

CONSTANT SPRITE_PLAYER = 0
CONSTANT SPRITE_WEAPON = 16
CONSTANT SPRITE_MAP    = 64

CONSTANT MAIN_BANK = 0

CONSTANT SPRITE_BANK_1 = 4
CONSTANT SPRITE_BANK_2 = 5
CONSTANT SPRITE_BANK_3 = 6
CONSTANT SPRITE_BANK_4 = 7

CONSTANT TILE_BANK_1 = 8
CONSTANT TILE_BANK_2 = 9
CONSTANT TILE_BANK_3 = 10
CONSTANT TILE_BANK_4 = 11

CONSTANT BACK_BANK_1 = 12
CONSTANT BACK_BANK_2 = 13
CONSTANT BACK_BANK_3 = 14
CONSTANT BACK_BANK_4 = 15

CONSTANT MAP_BANK_1 = 16
CONSTANT MAP_BANK_2 = 17
CONSTANT MAP_BANK_3 = 18
CONSTANT MAP_BANK_4 = 19

CONSTANT FPS = 60

CONSTANT FRAME_S = 0
CONSTANT FRAME_S_1 = 0
CONSTANT FRAME_S_2 = 2

CONSTANT FRAME_E = 4
CONSTANT FRAME_E_1 = 4
CONSTANT FRAME_E_2 = 6

CONSTANT FRAME_N = 8
CONSTANT FRAME_N_1 = 8
CONSTANT FRAME_N_2 = 10

CONSTANT FRAME_W = 12
CONSTANT FRAME_W_1 = 12
CONSTANT FRAME_W_2 = 14

DEFINE Player RECORD
	x BYTE, // sprite x position
	y BYTE, // sprite y position
	f BYTE, // sprite frame
	m BYTE, // sprite movement
	tx BYTE, // sprite facing towards x
	ty BYTE // sprite facing towards y
END

DEFINE Map RECORD
	peek BYTE,
	peek_1 BYTE,
	peek_2 BYTE,
END

DECLARE player TYPE Player
DECLARE map TYPE Map


CONSTANT BORDER_LEFT_ON = 1
CONSTANT BORDER_NO_SCROLL_LEFT = 2
CONSTANT BORDER_NO_SCROLL_BOTTOM = 2

CONSTANT FLAG_SOLID = 32
CONSTANT FLAG_HARM  = 64
CONSTANT FLAG_BLESS = 128


// Reads the map flag from video memory.
// There are 3 extra bits available which Lox uses for collision detection.
// For a sprite X and Y should be adjusted depending on its size.
PROCEDURE map_flag_at(x BYTE, y BYTE, var BYTE) BYTE
	RETURN read_vram(WORD(x>>3)+WORD(y<<3)+VDP_TILE_MAP)
END

INCLUDE "nun.plz"
INCLUDE "font.plz"

PROCEDURE print_abc()
	DECLARE letter BYTE
	DECLARE i BYTE
	WHILE i < 26 DO
		LET letter = 'A' + i
		CALL print_char(letter)
		LET i = i + 1
	END
END

PROCEDURE print_abc_l()
	DECLARE letter BYTE
	DECLARE i BYTE
	WHILE i < 26 DO
		LET letter = 'a' + i
		CALL print_char(letter)
		LET i = i + 1
	END
END

CONSTANT NUN_TILE_COUNT = 32
CONSTANT NUN_LINE_WITH  = 4
PROCEDURE draw_nun()
	DECLARE nun_pattern BYTE
	DECLARE row BYTE = 1
	FOR nun_pattern = 128 TO 128 + NUN_TILE_COUNT DO
		IF (WORD(row) % NUN_LINE_WITH) == 0 THEN DO
			LET row = row + 1
			CALL set_cursor(BYTE(row),1)
		END
		CALL print_char(nun_pattern)
	END
END

start:
	DISABLE
// Set up screen
	MODE(4)
	CALL halt_vsync // To avoid flashing and tearing
	CALL load_palette_default
	CALL border_color(7)
	CALL cls
//	BANK 1

	CALL load_tiles('A', font, 26)

	CALL load_tiles('a', font_l, 26)
    // CALL load_tiles(128, nun_tiles, NUN_TILE_COUNT)
//	BANK 0
	DECLARE nun_pattern BYTE
/*	CALL set_cursor(1,15)
	CALL print_char('A')
	CALL print_char('B')
